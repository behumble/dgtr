# =============================================================
# dgtr - Daily Google Tasks Review
# Each user puts their OWN Google OAuth credentials here.
# NEVER commit this file to git (see .gitignore).
#
# 1) Create a Desktop OAuth client in Google Cloud Console
#    -> https://console.cloud.google.com/apis/credentials
#    (enable "Google Tasks API" for the project first)
# 2) Fill in the two values below.
# 3) Run: dgtr login   (opens browser, stores refresh token)
# =============================================================

GOOGLE_TASKS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_TASKS_CLIENT_SECRET=your-client-secret

# The refresh token below is written automatically by `dgtb login`.
# You do not need to create it by hand.
#GOOGLE_TASKS_REFRESH_TOKEN=
